# Copy these values into your hosting provider's environment settings.
# Never commit real SMTP credentials to Git.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=website@alify.com
INQUIRY_NOTIFICATION_EMAIL=hello@alify.com
